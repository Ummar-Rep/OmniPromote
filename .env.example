# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Used to look up email addresses for notifications. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL of the site (used in auth redirects and emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: email notifications through https://resend.com
RESEND_API_KEY=
EMAIL_FROM="OmniPromote <notifications@yourdomain.ae>"

# Phase 2: online payments with Stripe (https://dashboard.stripe.com/apikeys). Leave empty to use bank transfer only.
STRIPE_SECRET_KEY=
# From Stripe → Developers → Webhooks after adding https://yourdomain/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Any long random string. Vercel sends it to the daily auto-approve job.
CRON_SECRET=
